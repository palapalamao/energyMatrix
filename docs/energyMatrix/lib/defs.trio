//
// energyMatrix 定义库（Haystack 4 defs / trio）
//
// ── 为什么是 trio 而不是 Xeto ────────────────────────────────────────────
// 说明书 §2.2 交付的是 Xeto 库 `em`（Haystack 5 / Haxall 4.x 的规格语言）。
// 但本 pod 的目标运行环境 FIN 5.3 (hetan_5.3.0.2761) 内置 haystack 3.1.5.1，
// 属 Haystack 4 defs 体系，全部 284 个框架 pod 中不存在任何 xeto pod。
// 所以：
//   * res/spec/em/*.xeto  是**规格源真相**（人读 + 未来迁 Haxall 4 直接可用）
//   * lib/defs.trio       是 FIN 5.3 上的等价定义，本文件
// 两者的逐条差异记录在 README.md「与说明书的偏差」。
//
// ── 加载方式 ────────────────────────────────────────────────────────────
// 本 pod 走 `skyarc.ext` + `skyarc.lib` 注册路线（见 build.fan index）。
// FIN 自带的 energyExt.pod 同样只声明这两个键，却带着一份 lib/defs.trio，
// 说明这条路线下 lib/*.trio 会被当作定义源加载。
// 需要注意：即使定义没有被加载，Folio 也允许写入未声明的标签（coolMatrix 的
// cmXxx 就是这么用的），所以本文件对运行**不是**硬依赖 —— 它的价值在于让
// 标签在 FIN 的 def 浏览器 / 建模工具里可发现、可校验。
//
// ── 命名强制约束（说明书 §2.3）────────────────────────────────────────
// 本库所有自定义标签一律带 em 前缀。禁止直接向 ph 命名空间添加标签，
// 也禁止复用其他产品库（cm、hm）的私有标签，以保证同一 Folio 内多产品
// 共存时不发生语义冲突。
//

//////////////////////////////////////////////////////////////////////////
// 全局标记
//////////////////////////////////////////////////////////////////////////

--------------------------------------------------------------------------
def: ^energyMatrix
is: ^marker
doc: "energyMatrix 应用域全局标识，挂在所有本库托管的 rec 上"
--------------------------------------------------------------------------
def: ^emVirtual
is: ^marker
doc: "虚拟表 / 计算量，值由公式（emFormula）推导而非物理采集"
--------------------------------------------------------------------------
def: ^emGap
is: ^marker
doc:
  缺口量：总表与各分表之和的差值（不明用能）。说明书 §3.3.3 强制把它建模成
  一块显式存在的虚拟表，不允许在报表中被平摊或悄悄消失。
--------------------------------------------------------------------------
def: ^emSettlement
is: ^marker
doc: "结算用计量：参与对外结算或对内考核，精度与审计要求最高"
--------------------------------------------------------------------------
def: ^emNormalized
is: ^marker
doc: "归一化指标（单位面积 / 单位人数 / 度日数修正后），即点位规范的 L3 层"
--------------------------------------------------------------------------
def: ^emDelta
is: ^marker
doc: "L2 区间增量点：由 L1 累积读数差分得到，含溢出与换表补偿"
--------------------------------------------------------------------------
def: ^emL1Point
is: ^marker
doc:
  权威的 L1 累积读数点。一块表可能挂多个 total 点（分时电量也是 total），
  这个标记让 EmMeterReading 不必靠 navName 消歧。
--------------------------------------------------------------------------
def: ^emLocked
is: ^marker
doc: "业务参数版本已被已结算账期引用，只读；换版请新增记录（说明书 §5.4）"
--------------------------------------------------------------------------

//////////////////////////////////////////////////////////////////////////
// 域 1 · 空间与组织
//////////////////////////////////////////////////////////////////////////

--------------------------------------------------------------------------
def: ^emZone
is: ^marker
doc: "能耗核算分区：最小空间核算单元，可跨楼层"
--------------------------------------------------------------------------
def: ^emOrg
is: ^marker
doc: "组织单元 / 成本中心，构成与空间正交的第二棵树"
--------------------------------------------------------------------------
def: ^emTenant
is: ^marker
doc: "租户，账单付费方"
--------------------------------------------------------------------------
def: ^emCoolArea
is: ^number
quantity: "area"
doc: "空调面积，空调 EUI 的分母"
--------------------------------------------------------------------------
def: ^emOccupancy
is: ^number
doc: "设计在册人数，人均指标分母与 byHeadcount 分摊权重"
--------------------------------------------------------------------------
def: ^emBaseYear
is: ^number
doc: "能耗基准年"
--------------------------------------------------------------------------
def: ^emGapThreshold
is: ^number
doc:
  关账缺口率闸门阈值（0~1），缺省 0.05。允许按站点覆盖：不同项目的计量
  完备程度差别很大，一刀切会让计量薄弱的老项目永远关不了账。
--------------------------------------------------------------------------
def: ^emContractNo
is: ^str
doc: "租赁合同编号"
--------------------------------------------------------------------------
def: ^emLeaseStart
is: ^date
doc: "租期开始"
--------------------------------------------------------------------------
def: ^emLeaseEnd
is: ^date
doc: "租期结束"
--------------------------------------------------------------------------
def: ^emClimateZone
is: ^str
enum:
  - severeCold: 严寒地区
  - cold: 寒冷地区
  - hotSummerColdWinter: 夏热冬冷地区
  - hotSummerWarmWinter: 夏热冬暖地区
  - mild: 温和地区
doc: "建筑热工分区，EUI 对标与度日数修正的依据"
--------------------------------------------------------------------------
def: ^emUsageType
is: ^str
enum:
  - office: 办公
  - retail: 商业零售
  - hotel: 酒店
  - hospital: 医疗
  - datacenter: 数据中心
  - industrial: 工业 / 工艺
  - residence: 居住
  - common: 公区 / 公摊
  - parking: 车库
doc: "业态类型，用于 EUI 对标与定额分配"
--------------------------------------------------------------------------

//////////////////////////////////////////////////////////////////////////
// 域 2 · 计量
//////////////////////////////////////////////////////////////////////////

--------------------------------------------------------------------------
def: ^emMeterRole
is: ^str
enum:
  - gateway: 关口表 —— 与供能方结算的产权分界表，唯一权威源
  - main: 总表 —— 建筑或系统级汇总表
  - branch: 分项表 —— 按用能分项划分的回路表
  - sub: 子表 —— 租户 / 楼层 / 末端计量表
  - check: 考核表 —— 仅用于校核，不参与汇总，防止重复计量
  - virtual: 虚表 —— 由加减、分摊或差值公式导出
doc:
  计量角色。是六值枚举而不是 marker —— 汇总算法只识别角色、不识别层级深度，
  因此三层楼的项目与三十层的项目使用同一套汇总逻辑。
--------------------------------------------------------------------------
def: ^emMedium
is: ^str
enum:
  - elec: 电
  - water: 水（自来水 / 中水 / 直饮水）
  - gas: 燃气
  - steam: 蒸汽
  - heat: 热量（热水）
  - cool: 冷量（冷冻水）
  - diesel: 柴油
  - coal: 煤
  - hydrogen: 氢
doc:
  能源介质，跨介质统一折算与碳核算的依据。
  注意 xeto 原稿把它写成 Choice 却从未使用（全库用 emMediumId 自由文本），
  本库收敛成枚举，见 README 偏差 #5。
--------------------------------------------------------------------------
def: ^emSubItem
is: ^str
enum:
  - a1: A1 照明插座 - 室内照明与插座
  - a2: A2 照明插座 - 走廊与应急照明
  - a3: A3 照明插座 - 室外景观照明
  - b1: B1 空调用电 - 冷热站
  - b2: B2 空调用电 - 空调末端
  - c1: C1 动力用电 - 电梯扶梯
  - c2: C2 动力用电 - 水泵
  - c3: C3 动力用电 - 通风机
  - d1: D1 特殊用电 - 信息中心
  - d2: D2 特殊用电 - 厨房餐厅
  - d3: D3 特殊用电 - 洗衣房
  - d4: D4 特殊用电 - 游泳池
  - d5: D5 特殊用电 - 健身娱乐
  - d6: D6 特殊用电 - 其他
doc:
  GB 分项计量归类，依据《大型公共建筑能耗监测系统分项能耗数据采集技术导则》。
  **仅电介质有效** —— 水 / 气 / 汽 / 冷热没有分项计量口径。
--------------------------------------------------------------------------
def: ^emDataSource
is: ^str
enum:
  - measured: 实测，物理表计直采（可结算、可披露）
  - derived: 推导，由其他实测量运算得出（可结算、可披露）
  - allocated: 分摊，按规则从上级量分配（需规则备案 / 需注明分摊）
  - estimated: 估算，模型或历史均值填补（**不可结算、不可披露**）
  - manual: 人工录入，抄表或账单（需双人复核）
doc:
  数据来源分级 —— 所有能耗账目可审计性的根（铁律 4）。
  任何能耗数值必须可标注，缺失即视为校验失败，不得默认成 measured。
--------------------------------------------------------------------------
def: ^emMeterScope
is: ^str
doc:
  计量范围的文字描述，用于点表交底。
  注意不叫 meterScope —— 那个名字已被 phIoT 占用（^meterScope is ^choice，
  值 siteMeter/submeter），见 README 偏差 #3。
--------------------------------------------------------------------------
def: ^emFormula
is: ^str
doc:
  求值表达式（Axon）。用于虚拟表（emVirtual）、分摊规则（method=custom）
  与指标定义（EmKpi）。账期由 EmEvalScope 注入，公式里可直接写
  'emMeterRead(@M-B1-01) - emSubMeterSum(@M-B1-01)'。
--------------------------------------------------------------------------
def: ^emCtRatio
is: ^number
doc: "电流互感器变比，读数还原用"
--------------------------------------------------------------------------
def: ^emPtRatio
is: ^number
doc: "电压互感器变比"
--------------------------------------------------------------------------
def: ^emMeterFactor
is: ^number
doc: "综合倍率 = emCtRatio × emPtRatio"
--------------------------------------------------------------------------
def: ^emMaxReading
is: ^number
doc: "累积量翻转上限，用于溢出补偿（cur < prev 时 delta = max - prev + cur）"
--------------------------------------------------------------------------
def: ^emInstallDate
is: ^date
doc: "表计安装 / 换表日期，用于跨表连续计量的换表补偿"
--------------------------------------------------------------------------
def: ^emPhaseType
is: ^str
enum:
  - single: 单相
  - three: 三相
doc: "电表相制"
--------------------------------------------------------------------------
def: ^emWaterType
is: ^str
enum:
  - domestic: 自来水
  - reclaimed: 中水
  - direct: 直饮水
  - fire: 消防水
  - makeup: 补水
  - irrigation: 灌溉
doc: "水种细分"
--------------------------------------------------------------------------
def: ^emTouPeriod
is: ^str
enum:
  - sharp: 尖
  - peak: 峰
  - flat: 平
  - valley: 谷
doc: "分时电价时段"
--------------------------------------------------------------------------
def: ^emDemand
is: ^marker
doc: "需量点"
--------------------------------------------------------------------------
def: ^emLoadRate
is: ^marker
doc: "负载率点"
--------------------------------------------------------------------------
def: ^emStandardCond
is: ^marker
doc: "标况折算量 —— 碳核算与折标煤必须用标况量，不能用工况量"
--------------------------------------------------------------------------
def: ^emServesRef
is: ^ref
doc: "计量对象指向其服务的空间 / 设备 / 租户，构成能流下游边"
--------------------------------------------------------------------------
def: ^emSpaceRef
is: ^ref
doc: "归属空间（space / floor / zone）"
--------------------------------------------------------------------------
def: ^emTenantRef
is: ^ref
doc: "归属租户 / 组织单元"
--------------------------------------------------------------------------
def: ^emOrgRef
is: ^ref
doc: "归属组织单元 / 成本中心"
--------------------------------------------------------------------------
def: ^emParentRef
is: ^ref
doc: "上级组织，构成成本中心树（xeto 原稿写作 parentRef，见 README 偏差 #4）"
--------------------------------------------------------------------------
def: ^emMeterRef
is: ^ref
doc:
  归属表计。台账条目、用能设备、供能节点都用它指向自己的权威计量表。
  xeto 原稿在 L2 台账里写作 meterRef、在 L1 写作 emMeterRef，本库统一为
  emMeterRef（README 偏差 #4）。
--------------------------------------------------------------------------

