    + writeSeries(meter_south_gas_gw, 226.8, 2025-09-01, 13, southLy + 56000)

  ledgerRows: emLedgerBuild(site_hospital, toSpan(2026-09-01..2026-09-13), "daily").size
    + emLedgerBuild(site_east, toSpan(2026-09-01..2026-09-13), "daily").size
    + emLedgerBuild(site_west, toSpan(2026-09-01..2026-09-13), "daily").size
    + emLedgerBuild(site_south, toSpan(2026-09-01..2026-09-13), "daily").size
    + emLedgerBuild(site_hospital, toSpan(2026-08-01..2026-08-31), "daily").size
