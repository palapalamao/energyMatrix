// Default is preview-only. Change preview to false only after FIN Expert stages the unchanged request and the user confirms it.
do
  preview: true
  generation: "hospital-rich-demo-20260913"
  demoTags: {emSynthetic, emDataProvenance: generation}
  if (preview) return {batch: "04_operations_close", generation: generation, preview, summary: "anomalies, work orders, baselines, savings projects and one completed prior-month close"}

  site_hospital: read(energyMatrix and site and emDemoKey=="site-hospital-main", true)->id
  curSpan: toSpan(2026-09-01..2026-09-13)
  priorSpan: toSpan(2026-08-01..2026-08-31)

  meter_h_elec_gw: read(energyMatrix and meter and emDemoKey=="meter-h-elec-gw", true)->id
  meter_h_lighting_main: read(energyMatrix and meter and emDemoKey=="meter-h-lighting-main", true)->id
  meter_h_lighting_emergency: read(energyMatrix and meter and emDemoKey=="meter-h-lighting-emergency", true)->id
  meter_h_landscape: read(energyMatrix and meter and emDemoKey=="meter-h-landscape", true)->id
  meter_h_chiller_plant: read(energyMatrix and meter and emDemoKey=="meter-h-chiller-plant", true)->id
  meter_h_hvac_terminal: read(energyMatrix and meter and emDemoKey=="meter-h-hvac-terminal", true)->id
