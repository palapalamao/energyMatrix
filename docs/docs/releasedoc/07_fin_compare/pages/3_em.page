pageType: content
background:
  type: solid
  color: "$paper"
elements:
  - elementId: eyebrow
    elementType: text
    bounds: [64, 36, 500, 16]
    content:
      style: "$eyebrow"
      wrap: false
      text: 附件四 · 平台选型依据 —— energyMatrix 的加成
  - elementId: title
    elementType: text
    bounds: [64, 58, 832, 42]
    content:
      style: "$title"
      wrap: false
      text: energyMatrix = FIN 底座 + 能源语义与台账纪律
  - elementId: headrule
    elementType: shape
    bounds: [64, 110, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: q1box
    elementType: shape
    bounds: [64, 128, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: solid, color: "$softline", width: 1}
  - elementId: q1t
    elementType: text
    bounds: [84, 144, 364, 20]
    content: {fontSize: 14, bold: true, color: "$teal", wrap: false, text: ① 语义模型 em 库}
  - elementId: q1d
    elementType: text
    bounds: [84, 172, 364, 100]
    content:
      style: "$body"
      lineHeight: 1.6
      text: |
        <p>站点 / 楼层 / 分区 / 租户 / 计量树全部以 Haystack 4 标签建模；三层点位体系 L1 原始值 → L2 表码差 → L3 分项指标，每一度电的来路可追溯。</p>
