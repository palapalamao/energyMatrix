pageType: content
background:
  type: solid
  color: "$paper"
elements:
  - elementId: eyebrow
    elementType: text
    bounds: [64, 36, 500, 16]
    content:
      style: "$eyebrow"
      wrap: false
      text: DEPLOYMENT · 部署架构
  - elementId: title
    elementType: text
    bounds: [64, 58, 760, 42]
    content:
      style: "$title"
      wrap: false
      text: 单站点或多站点分布式应用场景
  - elementId: headrule
    elementType: shape
    bounds: [64, 110, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: cloud
    elementType: shape
    bounds: [280, 134, 400, 40]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: cloudtext
    elementType: text
    bounds: [280, 134, 400, 40]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      wrap: false
      text: FIN Network · 多站点集中管理
  - elementId: linkA
    elementType: line
    bounds: [156, 174, 1, 40]
    viewBox: [1, 40]
    points: "0,0 0,40"
    curve: sharp
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: linkB
    elementType: line
    bounds: [480, 174, 1, 40]
    viewBox: [1, 40]
    points: "0,0 0,40"
    curve: sharp
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: linkC
    elementType: line
    bounds: [804, 174, 1, 40]
    viewBox: [1, 40]
    points: "0,0 0,40"
    curve: sharp
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: diagA
    elementType: line
    bounds: [156, 154, 124, 20]
    viewBox: [124, 20]
    points: "0,20 124,0"
    curve: sharp
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: diagC
    elementType: line
    bounds: [680, 154, 124, 20]
    viewBox: [124, 20]
    points: "0,0 124,20"
    curve: sharp
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: siteA
    elementType: shape
    bounds: [64, 214, 184, 92]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: siteAicon
    elementType: icon
    bounds: [80, 228, 22, 22]
    iconName: "fas:server"
    fill: {type: solid, color: "$tealDark"}
  - elementId: siteAtitle
    elementType: text
    bounds: [110, 226, 130, 22]
    content: {fontSize: 13, bold: true, color: "$ink", wrap: false, text: 站点 A · 边缘控制器}
  - elementId: siteAtext
    elementType: text
    bounds: [80, 254, 152, 44]
    content:
      fontSize: 10.5
      color: "$steel"
      lineHeight: 1.4
      text: F200 / NEXIO，内置 FIN Framework 与 energyMatrix，3,000 / 5,000 点
  - elementId: siteB
    elementType: shape
    bounds: [388, 214, 184, 92]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: siteBicon
    elementType: icon
    bounds: [404, 228, 22, 22]
    iconName: "fas:server"
    fill: {type: solid, color: "$tealDark"}
  - elementId: siteBtitle
    elementType: text
    bounds: [434, 226, 130, 22]
    content: {fontSize: 13, bold: true, color: "$ink", wrap: false, text: 站点 B · 边缘控制器}
  - elementId: siteBtext
    elementType: text
    bounds: [404, 254, 152, 44]
    content:
      fontSize: 10.5
      color: "$steel"
      lineHeight: 1.4
      text: 断网可独立运行，台账采集与关账在本地完成
  - elementId: siteC
    elementType: shape
    bounds: [712, 214, 184, 92]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: solid, width: 1.5, color: "$teal"}
  - elementId: siteCicon
    elementType: icon
    bounds: [728, 228, 22, 22]
    iconName: "fas:server"
    fill: {type: solid, color: "$tealDark"}
  - elementId: siteCtitle
    elementType: text
    bounds: [758, 226, 130, 22]
    content: {fontSize: 13, bold: true, color: "$ink", wrap: false, text: 站点 N · 边缘控制器}
  - elementId: siteCtext
    elementType: text
    bounds: [728, 254, 152, 44]
    content:
      fontSize: 10.5
      color: "$steel"
      lineHeight: 1.4
      text: 电 · 水 · 气 · 冷热量表计经 BACnet / Modbus / M-Bus / MQTT 接入
  - elementId: accessrule
    elementType: shape
    bounds: [64, 340, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: accesslabel
    elementType: text
    bounds: [64, 356, 200, 20]
    content: {fontSize: 12, bold: true, color: "$teal", wrap: false, text: 访问方式}
  - elementId: acc1icon
    elementType: icon
    bounds: [64, 388, 20, 20]
    iconName: "fas:globe"
    fill: {type: solid, color: "$tealDark"}
  - elementId: acc1
    elementType: text
    bounds: [94, 384, 200, 56]
    content:
      fontSize: 11.5
      color: "$steel"
      lineHeight: 1.45
      text: |
        <p><strong>网页浏览器</strong></p>
        <p>B/S 架构，组态、分析、关账全部在线完成</p>
  - elementId: acc2icon
    elementType: icon
    bounds: [340, 388, 20, 20]
    iconName: "fas:display"
    fill: {type: solid, color: "$tealDark"}
  - elementId: acc2
    elementType: text
    bounds: [370, 384, 200, 56]
    content:
      fontSize: 11.5
      color: "$steel"
      lineHeight: 1.45
      text: |
        <p><strong>嵌入式触摸屏</strong></p>
        <p>能源运行监控中心本地值守大屏</p>
  - elementId: acc3icon
    elementType: icon
    bounds: [616, 388, 20, 20]
    iconName: "fas:mobile-screen"
    fill: {type: solid, color: "$tealDark"}
  - elementId: acc3
    elementType: text
    bounds: [646, 384, 250, 56]
    content:
      fontSize: 11.5
      color: "$steel"
      lineHeight: 1.45
      text: |
        <p><strong>移动端速览</strong></p>
        <p>13 屏之一，负责人随时掌握关键指标</p>
  - elementId: footnote
    elementType: text
    bounds: [64, 480, 832, 32]
    content:
      style: "$note"
      text: 单站点：边缘控制器独立运行，无需额外服务器，减少 IT 设施投资；多站点：经 FIN Network 汇总至多项目总览，支持跨项目 EUI 排名与集团汇总。
