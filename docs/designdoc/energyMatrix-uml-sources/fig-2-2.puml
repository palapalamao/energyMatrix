@startuml
!include style.iuml
title 图 2-2  部署架构

node "现场层  Field" as N1 {
  rectangle "电表 · 水表 · 燃气表 · 冷热量表\nDDC / PLC / 网关\nModbus RTU · M-Bus · BACnet MSTP" as F1
}

node "边缘层  Edge   AI-BOX / NEXIO" as N2 {
  rectangle "FIN Framework (Haxall)\nenergyMatrix Pod\ncoolMatrix / heatMatrix Pod" as E1
  database "本地 Folio\n缓存 7 天" as E2
}

node "中心层  Center   阿里云 ECS" as N3 {
  rectangle "FIN Supervisor\nenergyMatrix Pod（主）\n模型工件库 *.onnx" as C1
  database "主 Folio\nrec + his" as C2
  database "备份 OSS\n日快照 90 天" as C3
}

node "客户端" as N4 {
  rectangle "浏览器\nReact SPA" as B1
}
cloud "外部系统" as N5 {
  rectangle "ERP / 物业收费\n集团碳管理平台" as X1
}

F1 --> E1 : Modbus TCP / BACnet IP
E1 --> E2
E1 --> C1 : FIN Replication\nHTTPS 443 出方向
C1 --> C2
C2 --> C3 : 每日快照
B1 --> C1 : HTTPS 443
C1 --> X1 : REST 出方向\n账单 · 碳账目
N4 -[hidden]right- N5
@enduml
