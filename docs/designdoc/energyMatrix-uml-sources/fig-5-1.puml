@startuml
!include style.iuml
title 图 5-1  前端分层与路由骨架

rectangle "路由骨架  Routes" #F4F7FA {
  rectangle "/em/overview\n/em/topology\n/em/ledger" as R1
  rectangle "/em/billing\n/em/kpi\n/em/mv" as R2
  rectangle "/em/carbon\n/em/diagnostics\n/em/settings" as R3
}
rectangle "业务组件  Feature" #F4F7FA {
  rectangle "SankeyFlowPanel\nMeterTreePanel\nLedgerTable + CloseGate" as F1
  rectangle "TariffEditor / BillDetail\nKpiBoard / QuotaProgress\nBaselineScatter / SavingsCard" as F2
  rectangle "CarbonStack / FactorLock\nAnomalyFeed / WorkOrder\nMeterImport / RoleMatrix" as F3
}
rectangle "图表原语  Primitives" #F4F7FA {
  rectangle "Sankey · TreeDag · BarMeter\nScatterRegression · StackedBar" as P1
}
rectangle "基础层  Foundation" #F4F7FA {
  rectangle "DesignTokens 色板/字阶/间距\nApiClient fetch + 错误码映射\nAuthGuard / PermGate\nQueryCache 账期维度缓存" as T1
}

R1 --> F1
R2 --> F2
R3 --> F3
F1 --> P1
F2 --> P1
F3 --> P1
F1 --> T1
F2 --> T1
F3 --> T1
P1 --> T1 : 取令牌
R1 -[hidden]right- R2
R2 -[hidden]right- R3
F1 -[hidden]right- F2
F2 -[hidden]right- F3
@enduml
