      return emAddSite(d->n,common.merge({area:d->a,emCoolArea:d->ca,emOccupancy:d->o,emUsageType:d->u,emClimateZone:d->cz,emBaseYear:d->by,emGapThreshold:d->g,emRegion:d->reg,tz:d->tz}))
