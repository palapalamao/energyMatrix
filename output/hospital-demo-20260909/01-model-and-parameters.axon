    if(d->t=="F") return emAddFloor(must(d->s),d->n,common.merge({floorNum:d->l,area:d->a,emUsageType:d->u,emOccupancy:d->o}))
    if(d->t=="Z") return emAddZone(must(d->s),d->n,common.merge({floorRef:must(d->f),area:d->a,emUsageType:d->u,emOccupancy:d->o}))
    if(d->t=="O") return emAddTenant(null,d->n,common.merge({siteRef:must(d->s),area:d->a,emUsageType:d->u,emOccupancy:d->o}))
    if(d->t=="M") do
      args:common.merge({emMeterRole:d->r,submeterOf:if(d["p"]==null)null else must(d->p),emSpaceRef:must(d->z),emTenantRef:must(d->o),emDataSource:d->ds,emMeterScope:d->sc+"; loadCategory="+d->lc})
      return emAddMeter(must(d->s),d->m,d->n,args.merge(if(d->r=="gateway"){emSettlement} else {}))
    end
    if(d->t=="G") return emAddGapMeter(must(d->s),must(d->src),d->n,common)
    throw("unsupported model row "+d->t)
  end
