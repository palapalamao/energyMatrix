  ]
  factorResults:factors.map(d=>do
    sourceSite:must(d->s)
    if(not (["previous","current"].contains(d->ver))) throw("unsupported emission factor version")
    factorMatches:readAll(emEmissionFactor and emMedium==d->m and emYear==d->y).findAll(r=>normalizeRegion(r["emRegion"])==normalizeRegion(d->reg))
    if(factorMatches.size>1) throw("ambiguous emission factor natural key")
    if(factorMatches.size==0) do
      keyed:byKey(d->k)
      if(keyed!=null) throw("emDemoKey does not match emission factor natural key: "+d->k)
      commit(diff(null,factorRecord(d),{add}))
      return {attempted:1,written:1,skipped:0,errors:0}
    end
    match:factorMatches.first
    keyed:byKey(d->k)
    if(keyed!=null and keyed->id!=match->id) throw("emDemoKey does not match emission factor natural key: "+d->k)
    if(match.missing("emSynthetic")) return {attempted:1,written:0,skipped:1,errors:0}
    if(match["emDataProvenance"]=="emDemoBuild") do
      adopted:factorRecord(d)
      commit(diff(match,adopted))
      return {attempted:1,written:1,skipped:0,errors:0}
    end
    if(match["emDataProvenance"]==generation) do
      if(keyed==null) do
        commit(diff(match,factorRecord(d)))
        return {attempted:1,written:1,skipped:0,errors:0}
      end
      return {attempted:1,written:0,skipped:1,errors:0}
    end
    throw("unsupported synthetic emission factor provenance")
  end)
