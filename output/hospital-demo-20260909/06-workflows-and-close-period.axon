    {k:"hd-anomaly-05",n:"医院能源异常模拟场景05",s:"hd-site-primary",meter:"hd-meter-primary-elec-imaging",rule:"hd-rule-peak",sub:"hd-meter-primary-elec-imaging",status:"resolved",work:"hd-work-order-05"},
    {k:"hd-anomaly-06",n:"医院能源异常模拟场景06",s:"hd-site-primary",meter:"hd-meter-primary-steam-sterilization",rule:"hd-rule-coverage",sub:"hd-meter-primary-steam-sterilization",status:"acked",work:null},
    {k:"hd-anomaly-07",n:"医院能源异常模拟场景07",s:"hd-site-primary",meter:"hd-meter-primary-elec-kitchen",rule:"hd-rule-quota",sub:"hd-quota-primary-elec",status:"falseAlarm",work:null},
    {k:"hd-anomaly-08",n:"医院能源异常模拟场景08",s:"hd-site-primary",meter:"hd-meter-primary-water-wards",rule:"hd-rule-water-leak",sub:"hd-meter-primary-water-wards",status:"open",work:null},
    {k:"hd-anomaly-09",n:"医院能源异常模拟场景09",s:"hd-site-primary",meter:"hd-meter-primary-heat-wards",rule:"hd-rule-carbon",sub:"hd-carbon-target-1",status:"acked",work:null},
    {k:"hd-anomaly-10",n:"医院能源异常模拟场景10",s:"hd-site-primary",meter:"hd-meter-primary-elec-hvac-terminals",rule:"hd-rule-hvac-drift",sub:"hd-meter-primary-elec-hvac-terminals",status:"dispatched",work:"hd-work-order-06"},
    {k:"hd-anomaly-11",n:"医院能源异常模拟场景11",s:"hd-site-primary",meter:"hd-meter-primary-elec-outpatient",rule:"hd-rule-quota",sub:"hd-quota-outpatient-elec",status:"falseAlarm",work:null},
    {k:"hd-anomaly-12",n:"医院能源异常模拟场景12",s:"hd-site-primary",meter:"hd-meter-primary-cool-critical",rule:"hd-rule-coverage",sub:"hd-meter-primary-cool-critical",status:"resolved",work:null}
  ]
  anomalyResults:anomalies.map(d=>do
    existing:existingKey(d->k)
    if(existing!=null) return {attempted:1,written:0,skipped:1,errors:0}
    rule:readById(must(d->rule))
    seedStatus:if(d->status=="resolved" and d["work"]==null)"resolved" else "open"
    rec:{energyMatrix,emAnomaly,emSynthetic,emDataProvenance:"hospitalDemo-20260909",emDemoKey:d->k,siteRef:must(d->s),emMeterRef:must(d->meter),emDiagRef:rule->id,emSubjectRef:must(d->sub),emCategory:rule->emCategory,emSeverity:rule->emSeverity,ts:now(),span:toSpan(today()..today()),emPeriod:"HD-DEMO-"+d->k,emAnomalyStatus:seedStatus,dis:d->n}
    commit(diff(null,rec,{add}))
    {attempted:1,written:1,skipped:0,errors:0}
  end)
  standaloneResults:anomalies.findAll(d=>d["work"]==null).map(d=>do
