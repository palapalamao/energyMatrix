    if(d->status=="acked" and current=="open") emAnomalyAck(anomaly,"合成演示确认")
    if(d->status=="falseAlarm" and current!="falseAlarm") emAnomalyFalseAlarm(anomaly,"合成演示误报")
    {attempted:1,written:if(current==d->status)0 else 1,skipped:if(current==d->status)1 else 0,errors:0}
  end)
  workOrders:[
    {k:"hd-work-order-01",n:"能源异常处置模拟工单01",s:"hd-site-primary",a:"hd-anomaly-01",status:"new",assignee:null,result:null,direct:true,path:"directCommit",audit:true,note:"No public factory creates the new state; public dispatch begins at assigned, so this direct synthetic seed is not publicly reachable."},
    {k:"hd-work-order-02",n:"能源异常处置模拟工单02",s:"hd-site-primary",a:"hd-anomaly-02",status:"assigned",assignee:null,result:null,direct:false,path:"publicTransition",audit:false,note:"Achievable synthetic workflow state derived from the linked anomaly."},
