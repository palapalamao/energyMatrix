    {k:"hd-anomaly-01",n:"医院能源异常模拟场景01",s:"hd-site-primary",meter:"hd-meter-primary-elec-information-rooms",rule:"hd-rule-night-base",sub:"hd-meter-primary-elec-information-rooms",status:"open",work:"hd-work-order-01"},
    {k:"hd-anomaly-02",n:"医院能源异常模拟场景02",s:"hd-site-primary",meter:"hd-meter-primary-elec-gateway",rule:"hd-rule-balance",sub:"hd-meter-primary-elec-gateway",status:"dispatched",work:"hd-work-order-02"},
    {k:"hd-anomaly-03",n:"医院能源异常模拟场景03",s:"hd-site-primary",meter:"hd-meter-primary-elec-cooling-plant",rule:"hd-rule-hvac-drift",sub:"hd-meter-primary-elec-cooling-plant",status:"dispatched",work:"hd-work-order-03"},
