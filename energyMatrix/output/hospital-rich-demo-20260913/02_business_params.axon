  if (read(emCarbonTarget and emDemoKey=="carbon-target-hospital-2026", false) == null) commit(diff(null, {energyMatrix, emCarbonTarget, emSynthetic, emDataProvenance: generation, emDemoKey: "carbon-target-hospital-2026", siteRef: site_hospital, emSubjectRef: site_hospital, dis: "某医院 2026 年度净碳排控制目标", emTargetType: "absolute", emTargetYear: 2026, emBaseValue: 16800000.0, emTargetValue: 14200000.0, emSourceDoc: "hospital-rich-demo synthetic carbon target"}, {add}))

  if (read(emGreenCert and emDemoKey=="green-cert-hospital-retired", false) == null) commit(diff(null, {energyMatrix, emGreenCert, emRetired, emSynthetic, emDataProvenance: generation, emDemoKey: "green-cert-hospital-retired", siteRef: site_hospital, emSubjectRef: site_hospital, dis: "某医院 2026 已注销绿证", emCertType: "gec", emCertNo: "GEC-2026-HOSP-1001", emVintage: 2026, val: 420000}, {add}))

  if (read(emGreenCert and emDemoKey=="green-cert-hospital-second", false) == null) commit(diff(null, {energyMatrix, emGreenCert, emRetired, emSynthetic, emDataProvenance: generation, emDemoKey: "green-cert-hospital-second", siteRef: site_hospital, emSubjectRef: site_hospital, dis: "某医院 2026 第二批已注销绿证", emCertType: "greenPower", emCertNo: "GP-2026-HOSP-1002", emVintage: 2026, val: 260000}, {add}))

  readAll(energyMatrix and emDataProvenance==generation).each(rec => commit(diff(rec, demoTags)))
  {batch: "02_business_params", generation: generation, kpis: 4, quotas: 6, tariffs: 3, diagRules: 4, factors: 6, carbonTargets: 2, greenCerts: 2}
