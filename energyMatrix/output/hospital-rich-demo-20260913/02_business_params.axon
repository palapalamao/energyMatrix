// energyMatrix hospital rich demo data
// generation: hospital-rich-demo-20260913
// batch: 02_business_params
// Default is preview-only. Change preview to false only after FIN Expert stages the unchanged request and the user confirms it.
do
  preview: true
  generation: "hospital-rich-demo-20260913"
  demoTags: {emSynthetic, emDataProvenance: generation}
  if (preview) return {batch: "02_business_params", generation: generation, preview, summary: "KPIs, quotas, tariffs, emission factors, carbon targets and green certificates"}

  site_hospital: read(energyMatrix and site and emDemoKey=="site-hospital-main", true)->id
  site_east: read(energyMatrix and site and emDemoKey=="site-east", true)->id
  site_west: read(energyMatrix and site and emDemoKey=="site-west", true)->id
  site_south: read(energyMatrix and site and emDemoKey=="site-south", true)->id
  qSpan: toSpan(2026-09-01..2026-09-13)

  kpi_eui_totalOld: read(emKpi and emKpiCode=="EUI_TOTAL", false)
  if (kpi_eui_totalOld == null) do
    kpi_eui_total: emAddKpi("EUI_TOTAL", "综合能耗强度", "emLedgerTotal(emSelf->id, emSpan) / emSelf->area", {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-eui-total", dis: "综合能耗强度", emKpiCode: "EUI_TOTAL", emFormula: "emLedgerTotal(emSelf->id, emSpan) / emSelf->area", unit: "kWh/m²", emGranularity: "monthly", emHigherIsBetter: false})
    commit(diff(readById(kpi_eui_total), {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-eui-total", dis: "综合能耗强度", emKpiCode: "EUI_TOTAL", emFormula: "emLedgerTotal(emSelf->id, emSpan) / emSelf->area", unit: "kWh/m²", emGranularity: "monthly", emHigherIsBetter: false}))
  end else commit(diff(kpi_eui_totalOld, {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-eui-total", dis: "综合能耗强度", emKpiCode: "EUI_TOTAL", emFormula: "emLedgerTotal(emSelf->id, emSpan) / emSelf->area", unit: "kWh/m²", emGranularity: "monthly", emHigherIsBetter: false}))
  kpi_eui_elecOld: read(emKpi and emKpiCode=="EUI_ELEC", false)
  if (kpi_eui_elecOld == null) do
    kpi_eui_elec: emAddKpi("EUI_ELEC", "单位面积电耗", "emLedgerTotal(emSelf->id, emSpan, \"elec\") / emSelf->area", {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-eui-elec", dis: "单位面积电耗", emKpiCode: "EUI_ELEC", emFormula: "emLedgerTotal(emSelf->id, emSpan, \"elec\") / emSelf->area", unit: "kWh/m²", emGranularity: "monthly", emHigherIsBetter: false})
    commit(diff(readById(kpi_eui_elec), {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-eui-elec", dis: "单位面积电耗", emKpiCode: "EUI_ELEC", emFormula: "emLedgerTotal(emSelf->id, emSpan, \"elec\") / emSelf->area", unit: "kWh/m²", emGranularity: "monthly", emHigherIsBetter: false}))
  end else commit(diff(kpi_eui_elecOld, {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-eui-elec", dis: "单位面积电耗", emKpiCode: "EUI_ELEC", emFormula: "emLedgerTotal(emSelf->id, emSpan, \"elec\") / emSelf->area", unit: "kWh/m²", emGranularity: "monthly", emHigherIsBetter: false}))
  kpi_carbon_intensityOld: read(emKpi and emKpiCode=="CARBON_INTENSITY", false)
  if (kpi_carbon_intensityOld == null) do
    kpi_carbon_intensity: emAddKpi("CARBON_INTENSITY", "单位面积净碳排", "emCarbonNet(emSelf->id, emSpan) / emSelf->area", {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-carbon-intensity", dis: "单位面积净碳排", emKpiCode: "CARBON_INTENSITY", emFormula: "emCarbonNet(emSelf->id, emSpan) / emSelf->area", unit: "kgCO2e/m²", emGranularity: "monthly", emHigherIsBetter: false})
    commit(diff(readById(kpi_carbon_intensity), {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-carbon-intensity", dis: "单位面积净碳排", emKpiCode: "CARBON_INTENSITY", emFormula: "emCarbonNet(emSelf->id, emSpan) / emSelf->area", unit: "kgCO2e/m²", emGranularity: "monthly", emHigherIsBetter: false}))
  end else commit(diff(kpi_carbon_intensityOld, {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-carbon-intensity", dis: "单位面积净碳排", emKpiCode: "CARBON_INTENSITY", emFormula: "emCarbonNet(emSelf->id, emSpan) / emSelf->area", unit: "kgCO2e/m²", emGranularity: "monthly", emHigherIsBetter: false}))
  kpi_water_per_bedOld: read(emKpi and emKpiCode=="WATER_PER_BED", false)
  if (kpi_water_per_bedOld == null) do
    kpi_water_per_bed: emAddKpi("WATER_PER_BED", "人均水耗", "emLedgerTotal(emSelf->id, emSpan, \"water\") / emSelf->emOccupancy", {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-water-per-bed", dis: "人均水耗", emKpiCode: "WATER_PER_BED", emFormula: "emLedgerTotal(emSelf->id, emSpan, \"water\") / emSelf->emOccupancy", unit: "m³/人", emGranularity: "monthly", emHigherIsBetter: false})
