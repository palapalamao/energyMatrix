    quota_hospital_quota_heat: emAddQuota(site_hospital, 320000, "benchmark", qSpan, {dis: "某医院月度供热上限", emMedium: "heat", emWarnRatio: 0.9, emOverAction: "notify"})
    commit(diff(readById(quota_hospital_quota_heat), {emSynthetic, emDataProvenance: generation, emDemoKey: "quota-hospital-quota-heat"}))
  end

  if (read(emTariff and emDemoKey=="tariff-elec-hospital", false) == null) commit(diff(null, {
    energyMatrix, emTariff, emSynthetic, emDataProvenance: generation, emDemoKey: "tariff-elec-hospital",
    siteRef: site_hospital, dis: "某医院大工业分时电价 2026", emMedium: "elec",
    emPricingModel: "tou", emEffective: toSpan(2026-01-01..2026-12-31), emUnitPrice: 0.82, emPriceUnit: "CNY/kWh",
    emSourceDoc: "hospital-rich-demo synthetic tariff, not for settlement"
  }, {add}))

  if (read(emTariff and emDemoKey=="tariff-water-hospital", false) == null) commit(diff(null, {
    energyMatrix, emTariff, emSynthetic, emDataProvenance: generation, emDemoKey: "tariff-water-hospital",
    siteRef: site_hospital, dis: "某医院自来水综合水价 2026", emMedium: "water",
    emPricingModel: "flat", emEffective: toSpan(2026-01-01..2026-12-31), emUnitPrice: 4.65, emPriceUnit: "CNY/m³",
    emSourceDoc: "hospital-rich-demo synthetic tariff, not for settlement"
  }, {add}))

  if (read(emTariff and emDemoKey=="tariff-gas-hospital", false) == null) commit(diff(null, {
    energyMatrix, emTariff, emSynthetic, emDataProvenance: generation, emDemoKey: "tariff-gas-hospital",
    siteRef: site_hospital, dis: "某医院天然气合同价 2026", emMedium: "gas",
    emPricingModel: "flat", emEffective: toSpan(2026-01-01..2026-12-31), emUnitPrice: 3.42, emPriceUnit: "CNY/m³",
    emSourceDoc: "hospital-rich-demo synthetic tariff, not for settlement"
  }, {add}))

  if (read(emDiagnostic and emDemoKey=="diag-hospital-dq", false) == null) do
    rule_hospital_dq: emAddDiagRule(site_hospital, "DQ-01", "主院区数据完好率低于 90%", "dataQuality", "warn", 0.9)
    commit(diff(readById(rule_hospital_dq), {emSynthetic, emDataProvenance: generation, emDemoKey: "diag-hospital-dq"}))
  end

  if (read(emDiagnostic and emDemoKey=="diag-hospital-balance", false) == null) do
