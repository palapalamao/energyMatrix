    commit(diff(readById(rule_hospital_balance), {emSynthetic, emDataProvenance: generation, emDemoKey: "diag-hospital-balance"}))
  end

  if (read(emDiagnostic and emDemoKey=="diag-hospital-hvac", false) == null) do
    rule_hospital_hvac: emAddDiagRule(site_hospital, "HVAC-01", "冷站单位冷量电耗偏高", "efficiency", "warn", 0.72)
    commit(diff(readById(rule_hospital_hvac), {emSynthetic, emDataProvenance: generation, emDemoKey: "diag-hospital-hvac"}))
