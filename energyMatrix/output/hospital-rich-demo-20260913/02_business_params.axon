    commit(diff(readById(quota_hospital_quota_steam), {emSynthetic, emDataProvenance: generation, emDemoKey: "quota-hospital-quota-steam"}))
  end

  if (read(emQuota and emDemoKey=="quota-hospital-quota-cool", false) == null) do
    quota_hospital_quota_cool: emAddQuota(site_hospital, 520000, "benchmark", qSpan, {dis: "某医院月度供冷上限", emMedium: "cool", emWarnRatio: 0.9, emOverAction: "notify"})
    commit(diff(readById(quota_hospital_quota_cool), {emSynthetic, emDataProvenance: generation, emDemoKey: "quota-hospital-quota-cool"}))
