  end else commit(diff(kpi_water_per_bedOld, {emSynthetic, emDataProvenance: generation, emDemoKey: "kpi-water-per-bed", dis: "人均水耗", emKpiCode: "WATER_PER_BED", emFormula: "emLedgerTotal(emSelf->id, emSpan, \"water\") / emSelf->emOccupancy", unit: "m³/人", emGranularity: "monthly", emHigherIsBetter: false}))

  if (read(emQuota and emDemoKey=="quota-hospital-quota-elec", false) == null) do
    quota_hospital_quota_elec: emAddQuota(site_hospital, 1550000, "standard", qSpan, {dis: "某医院月度电耗上限", emMedium: "elec", emWarnRatio: 0.9, emOverAction: "notify"})
    commit(diff(readById(quota_hospital_quota_elec), {emSynthetic, emDataProvenance: generation, emDemoKey: "quota-hospital-quota-elec"}))
  end

  if (read(emQuota and emDemoKey=="quota-hospital-quota-water", false) == null) do
    quota_hospital_quota_water: emAddQuota(site_hospital, 23500, "historical", qSpan, {dis: "某医院月度水耗上限", emMedium: "water", emWarnRatio: 0.9, emOverAction: "notify"})
    commit(diff(readById(quota_hospital_quota_water), {emSynthetic, emDataProvenance: generation, emDemoKey: "quota-hospital-quota-water"}))
