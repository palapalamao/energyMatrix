  if (factor_factor_gas_2026Old == null) commit(diff(null, {energyMatrix, emEmissionFactor, emSynthetic, emDataProvenance: generation, emDemoKey: "factor-gas-2026", dis: "天然气排放因子 2026", emMedium: "gas", emScope: "scope1", emRegion: "华东", emYear: 2026, emFactor: 2.19, emFactorUnit: "kgCO2e/m³", emCoalFactor: 1.33, emSourceDoc: "hospital-rich-demo synthetic factor set, not for disclosure"}, {add})) else commit(diff(factor_factor_gas_2026Old, {energyMatrix, emEmissionFactor, emSynthetic, emDataProvenance: generation, emDemoKey: "factor-gas-2026", dis: "天然气排放因子 2026", emMedium: "gas", emScope: "scope1", emRegion: "华东", emYear: 2026, emFactor: 2.19, emFactorUnit: "kgCO2e/m³", emCoalFactor: 1.33, emSourceDoc: "hospital-rich-demo synthetic factor set, not for disclosure"}))

