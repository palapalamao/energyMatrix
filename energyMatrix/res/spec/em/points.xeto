//
// 点位规范
// 三层点位约定（能耗数据链的关键）：
//   L1 raw    累积读数（表底数）  total + sensor        —— 直采，禁止修改
//   L2 delta  区间增量           emDelta + his rollup  —— 由 raw 差分，含翻转/换表补偿
//   L3 index  归一化指标         emNormalized          —— 业务层生成（见业务对象模型）
// 所有 L1/L2 点位强制 his + hisInterpolate:"linear" + tz 继承 site。
//

emDelta: Marker <doc:"区间增量点，由累积量差分得到">

// --- 电 -------------------------------------------------------------------

EmElecEnergyTotal: NumberPoint {
  elec, energy, sensor, total
  unit: "kWh"
  his
}

EmElecEnergyTou: NumberPoint {
  elec, energy, sensor, total
  emTouPeriod: Str <doc:"sharp | peak | flat | valley">
  unit: "kWh"
  his
}
emTouPeriod: Str <doc:"分时电价时段">

EmElecPowerActive: NumberPoint {
  elec, power, sensor
  unit: "kW"
  his
}

EmElecPowerReactive: NumberPoint {
  elec, power, reactive, sensor
  unit: "kVAR"
  his
}

EmElecDemand: NumberPoint {
  elec, power, sensor, max
  emDemand
  unit: "kW"
  his
}
emDemand: Marker <doc:"需量">

EmPowerFactor: NumberPoint { elec, pf, sensor, his }
EmVolt:        NumberPoint { elec, volt, sensor, unit:"V", his }
EmCurrent:     NumberPoint { elec, current, sensor, unit:"A", his }
EmFreq:        NumberPoint { elec, freq, sensor, unit:"Hz", his }
EmLoadRate:    NumberPoint { elec, sensor, emLoadRate, unit:"%", his }
emLoadRate:    Marker <doc:"负载率">

// --- 重点负荷与电气安全监测（V0.1.3 新增，见需求文档 7.3） -----------------
// 只监测不控制：本组点位全部 his 留痕，经既有 hisRead 通道读取，
// 不产生 L2 台账口径（emDelta/emNormalized 不适用）。

EmInsulationResistance: NumberPoint { elec, sensor, emInsulation, unit:"kΩ", his }
emInsulation:           Marker <doc:"IT 系统绝缘监测（IEC 60364-7-710）">

EmThdV:     NumberPoint { elec, sensor, emThd, emThdV, unit:"%", his }
EmThdI:     NumberPoint { elec, sensor, emThd, emThdI, unit:"%", his }
emThd:      Marker <doc:"总谐波畸变率">
emThdV:     Marker <doc:"电压总谐波畸变率（THDV）">
emThdI:     Marker <doc:"电流总谐波畸变率（THDI）">

EmUnbalance: NumberPoint { elec, sensor, emUnbalance, unit:"%", his }
emUnbalance: Marker <doc:"三相电压不平衡度">

EmResidualCurrent: NumberPoint { elec, sensor, emResidualCurrent, unit:"mA", his }
emResidualCurrent: Marker <doc:"剩余/漏电流（电气火灾预警）">

// --- 水 / 气 / 汽 ---------------------------------------------------------

EmWaterVolumeTotal: NumberPoint { water, volume, sensor, total, unit:"m³", his }
EmWaterFlow:        NumberPoint { water, flow, sensor, unit:"m³/h", his }
EmGasVolumeTotal:   NumberPoint { naturalGas, volume, sensor, total, unit:"m³", his }
EmGasFlow:          NumberPoint { naturalGas, flow, sensor, unit:"m³/h", his }
EmGasTempComp:      NumberPoint { naturalGas, volume, sensor, total, emStandardCond, unit:"m³", his }
emStandardCond:     Marker <doc:"标况折算量">
EmSteamMassTotal:   NumberPoint { steam, sensor, total, unit:"kg", his }
EmSteamFlow:        NumberPoint { steam, flow, sensor, unit:"kg/h", his }
EmSteamTemp:        NumberPoint { steam, temp, sensor, unit:"°C", his }
EmSteamPressure:    NumberPoint { steam, pressure, sensor, unit:"kPa", his }

// --- 冷 / 热 --------------------------------------------------------------

EmThermalEnergyTotal: NumberPoint { energy, sensor, total, unit:"kWh", his }
EmThermalPower:       NumberPoint { power, sensor, unit:"kW", his }
EmEnteringTemp:       NumberPoint { water, temp, sensor, entering, unit:"°C", his }
EmLeavingTemp:        NumberPoint { water, temp, sensor, leaving, unit:"°C", his }
EmDeltaTemp:          NumberPoint { water, temp, sensor, delta, unit:"°C", his }
EmTemp:               NumberPoint { temp, sensor, unit:"°C", his }

// --- 产储 -----------------------------------------------------------------

EmIrradiance:       NumberPoint { solar, sensor, unit:"W/m²", his }
EmPerformanceRatio: NumberPoint { emPr, sensor, unit:"%", his }
emPr: Marker <doc:"光伏系统效率 PR">
EmSoc: NumberPoint { emSoc, sensor, unit:"%", his }
emSoc: Marker <doc:"荷电状态">
EmSoh: NumberPoint { emSoh, sensor, unit:"%", his }
emSoh: Marker <doc:"健康度">

// ---------------------------------------------------------------------------
// L2 区间增量点（偏差 #6）
//
// 原稿只声明了一个 `emDelta: Marker`，没有任何具体的 delta point spec ——
// L1 raw 有 29 个 spec，L2 delta 是 0 个。但溢出补偿（emMaxReading）与换表
// 补偿（emInstallDate）这条链是说明书 §3.6 的核心，没有落点的话「读数」与
// 「增量」在模型层根本没有分开，历史汇总时只能现场处理。
//
// 差分算法见 fan/meter/EmMeterReadingCalc.fan（纯函数，可单测）。
// ---------------------------------------------------------------------------

EmElecEnergyDelta: NumberPoint {
  elec, energy, sensor
  emDelta
  unit: "kWh"
  his
}

EmWaterVolumeDelta: NumberPoint {
  water, volume, sensor
  emDelta
  unit: "m³"
  his
}

EmGasVolumeDelta: NumberPoint {
  naturalGas, volume, sensor
  emDelta
  unit: "m³"
  his
}

EmSteamMassDelta: NumberPoint {
  steam, sensor
  emDelta
  unit: "kg"
  his
}

// 冷量与热量共用：由所属表的 chilled / hot 标记区分
EmThermalEnergyDelta: NumberPoint {
  energy, sensor
  emDelta
  unit: "kWh"
  his
}
