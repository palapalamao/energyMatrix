//
// 全局标签、枚举与 Choice 定义
// 约定：本库所有自定义标签一律以 em 前缀命名，避免与 ph/phIoT 冲突
//
// ⚠ 本文件是《energyMatrix 语义模型设计说明书 V1.0》交付的 xeto 原稿的
//   **修正版**（收录在 pod 的 res/spec/em/ 下作为规格源真相）。
//   与原稿的逐条差异见 extensions/energyMatrix/README.md「与说明书的偏差」。
//   FIN 5.3 不解析 xeto —— 运行时生效的等价定义在 lib/defs.trio。
//

// ---------------------------------------------------------------------------
// 全局 Marker
// ---------------------------------------------------------------------------

energyMatrix: Marker <doc:"energyMatrix 应用域全局标识，挂在所有本库托管的 rec 上">
emVirtual:    Marker <doc:"虚拟表 / 计算量，值由公式推导而非物理采集">
emSettlement: Marker <doc:"结算用计量，参与对外结算或对内考核，精度与审计要求最高">
emGap:        Marker <doc:"缺口量：总表与各分表之和的差值（不明用能）">
emNormalized: Marker <doc:"归一化指标（单位面积/单位产量/度日数修正后）">

// ---------------------------------------------------------------------------
// 能源介质
//
// 偏差 #5（README）：原稿把 EmMedium 定义成 Choice，却在 ledger / tariff /
// kpi / baseline / carbon / supply 全部改用 `emMediumId: Str` 自由文本，
// Choice 形同虚设 —— 跨介质折标煤与碳核算失去类型保障，且 Choice 子项名
// （Elec / Water / Gas / Steam）与 ph 命名空间存在撞名风险。
// 这里收敛成 Enum，标签名统一为 emMedium。
//
// 载体标记仍复用 ph::Substance（naturalGas / chilled-water / hot-water /
// domestic-water …），Enum 只负责"这笔账属于哪种介质"的分类。
// ---------------------------------------------------------------------------

EmMedium: Enum {
  elec     <doc:"电">
  water    <doc:"水（自来水/中水/直饮水）">
  gas      <doc:"燃气">
  steam    <doc:"蒸汽">
  heat     <doc:"热量（热水）">
  cool     <doc:"冷量（冷冻水）">
  diesel   <doc:"柴油">
  coal     <doc:"煤">
  hydrogen <doc:"氢">
}

emMedium: EmMedium <doc:"能源介质，跨介质统一折算与碳核算的依据">

// ---------------------------------------------------------------------------
// 计量角色：决定校验规则、平衡校核方向、数据质量等级
// ---------------------------------------------------------------------------

EmMeterRole: Enum {
  gateway  <doc:"关口表：与供能方结算的产权分界表，唯一权威源">
  main     <doc:"总表：建筑/系统级汇总表">
  branch   <doc:"分项表：按用能分项划分的回路表">
  sub      <doc:"子表：租户/楼层/末端计量表">
  check    <doc:"考核表：用于校核而不参与汇总，防止重复计量">
  virtual  <doc:"虚表：由公式（加减/分摊/差值）导出">
}

emMeterRole: EmMeterRole <doc:"计量角色">

// ---------------------------------------------------------------------------
// 分项计量分类
// 依据《国家机关办公建筑和大型公共建筑能耗监测系统分项能耗数据采集技术导则》
// 及 GB/T 51161 民用建筑能耗标准
// ---------------------------------------------------------------------------

EmSubItem: Enum {
  a1 <doc:"A1 照明插座-室内照明与插座">
  a2 <doc:"A2 照明插座-走廊与应急照明">
  a3 <doc:"A3 照明插座-室外景观照明">
  b1 <doc:"B1 空调用电-冷热站（冷机/热泵/水泵/冷塔）">
  b2 <doc:"B2 空调用电-空调末端（AHU/FCU/新风）">
  c1 <doc:"C1 动力用电-电梯扶梯">
  c2 <doc:"C2 动力用电-水泵（给排水/生活）">
  c3 <doc:"C3 动力用电-通风机">
  d1 <doc:"D1 特殊用电-信息中心/机房">
  d2 <doc:"D2 特殊用电-厨房餐厅">
  d3 <doc:"D3 特殊用电-洗衣房">
  d4 <doc:"D4 特殊用电-游泳池">
  d5 <doc:"D5 特殊用电-健身房/娱乐">
  d6 <doc:"D6 特殊用电-其他（充电桩/舞台/工艺）">
}

emSubItem: EmSubItem? <doc:"GB 分项计量归类；仅电介质有效">

// ---------------------------------------------------------------------------
// 用能属性维度：支撑多维度（空间/业态/分项/组织）交叉分析
// ---------------------------------------------------------------------------

EmUsageType: Enum {
  office     <doc:"办公">
  retail     <doc:"商业零售">
  hotel      <doc:"酒店">
  hospital   <doc:"医疗">
  datacenter <doc:"数据中心">
  industrial <doc:"工业/工艺">
  residence  <doc:"居住">
  common     <doc:"公区/公摊">
  parking    <doc:"车库">
}

emUsageType: EmUsageType? <doc:"业态类型，用于 EUI 对标与定额分配">

// ---------------------------------------------------------------------------
// 数据质量与来源，是所有能耗账目可追溯性的根
// ---------------------------------------------------------------------------

EmDataSource: Enum {
  measured   <doc:"实测：物理表计直采">
  derived    <doc:"推导：由其他实测量运算得出">
  allocated  <doc:"分摊：按规则从上级量分配">
  estimated  <doc:"估算：模型/历史均值填补">
  manual     <doc:"人工录入（抄表/账单）">
}

emDataSource: EmDataSource <doc:"数据来源等级，任何能耗数值必须可标注">

// ---------------------------------------------------------------------------
// 关系型标签（Ref）
// ---------------------------------------------------------------------------

emServesRef:  Ref <doc:"计量对象指向其服务的空间/设备/租户，构成能流下游边">
emSpaceRef:   Ref <doc:"归属空间（space/floor/zone）">
emTenantRef:  Ref <doc:"归属租户/组织单元">
emFormula:    Str <doc:"虚拟表求值表达式（Axon），仅 emVirtual 有效">
emCtRatio:    Number <doc:"电流互感器变比，读数还原用">
emPtRatio:    Number <doc:"电压互感器变比">
emMeterFactor: Number <doc:"综合倍率 = ctRatio * ptRatio">
emInstallDate: Date <doc:"表计安装/换表日期，用于跨表连续计量">
emMaxReading: Number <doc:"累积量翻转上限，用于溢出补偿">

// ---------------------------------------------------------------------------
// 本 pod 的增补标签（说明书没有，但工程落地必需）
// 详见 README「与说明书的偏差」
// ---------------------------------------------------------------------------

emL1Point: Marker <doc:"权威的 L1 累积读数点；一块表可能挂多个 total 点，靠它消歧">
emPeriod:  Str <doc:"账期键，span 的可索引投影：2026-07-15 / 2026-07 / 2026-07-15T13 / 2026">
emGapThreshold: Number <doc:"关账缺口率闸门阈值（0~1），缺省 0.05，可按站点覆盖">
emLocked:  Marker <doc:"业务参数版本已被已结算账期引用，只读；换版请新增记录">
emCorrects: Ref <doc:"重录条目指向被修正的原条目，与 emReversalOf 一起构成完整修正链">
