//
// 域 3：供能 / 产能 / 储能域
// 原则：产能与储能设备既是"能源节点"，也必须挂表，走与用能侧一致的计量模型。
//       净电量约定：正 = 从电网购入 / 放电，负 = 上网 / 充电。
//

EmSupplyEquip: Equip {
  energyMatrix
  emSupply
  emMeterRef: Ref? <of:EmMeter, doc:"该能源节点的权威计量表">
}
emSupply: Marker <doc:"供能/产能/储能设备">

// 市政接入（产权分界点）
EmUtilityInlet: EmSupplyEquip {
  emUtilityInlet
  emMedium: EmMedium <doc:"介质。偏差 #5：原稿为 emMediumRef: Str，名字带 Ref 却是字符串">
  emSupplierName: Str? <doc:"供能单位">
  emTariffRef: Ref? <doc:"关联费率方案（业务层对象）">
}
emUtilityInlet: Marker <doc:"市政能源接入点/关口">

// 变配电
EmTransformer: EmSupplyEquip {
  elec
  transformer
  emRatedCapacity: Number <quantity:"apparentPower", unit:"kVA">
  points: {
    loadRate:     EmLoadRate?
    tempWinding:  EmTemp?
    powerActive:  EmElecPowerActive?
  }
}

// 医用 IT 隔离电源柜（V0.1.3 新增，见需求文档 7.3.2）
// 二类医疗场所（手术室、ICU 等）的 IT 系统，绝缘监测为核心量；
// 告警阈值参照 IEC 60364-7-710 的 50 Ω/V 惯例（220 V 系统约 50 kΩ，可逐柜配置）。
EmItIsolationPanel: EmSupplyEquip {
  elec
  emItIsolation
  emSystemVolt: Number <quantity:"volt", unit:"V">                        <doc:"IT 系统标称电压，如 220">
  emIrAlarmThreshold: Number <quantity:"insulationResistance", unit:"kΩ"> <doc:"绝缘电阻告警阈值，默认 50 Ω/V x 系统电压">
  points: {
    insulationResistance: EmInsulationResistance
    loadCurrent:          EmCurrent?
    tempWinding:          EmTemp?
  }
}
emItIsolation: Marker <doc:"医用 IT 隔离电源系统（二类医疗场所）">

// 光伏
EmPvSystem: EmSupplyEquip {
  elec
  emPv
  emRatedCapacity: Number <quantity:"power", unit:"kW">
  emPvArea: Number? <quantity:"area", unit:"m²">
  points: {
    energyGen:    EmElecEnergyTotal
    powerActive:  EmElecPowerActive?
    energyExport: EmElecEnergyTotal?  // 上网
    energySelf:   EmElecEnergyTotal?  // 自发自用
    irradiance:   EmIrradiance?
    pr:           EmPerformanceRatio?
  }
}
emPv: Marker <doc:"光伏发电系统">

// 储能
EmBess: EmSupplyEquip {
  elec
  emBess
  emRatedCapacity: Number <quantity:"energy", unit:"kWh">
  emRatedPower:    Number <quantity:"power", unit:"kW">
  points: {
    soc:           EmSoc
    powerActive:   EmElecPowerActive?
    energyCharge:  EmElecEnergyTotal?
    energyDischarge: EmElecEnergyTotal?
    soh:           EmSoh?
  }
}
emBess: Marker <doc:"电化学储能系统">

// 充电桩（作为特殊用电 D6，但独立建模以支持计费）
EmEvCharger: EmSupplyEquip {
  elec
  emEvCharger
  emRatedPower: Number <quantity:"power", unit:"kW">
  emChargerType: Str? <doc:"ac | dc">
  emGunQty: Number?
  points: {
    energyTotal:  EmElecEnergyTotal
    powerActive:  EmElecPowerActive?
  }
}
emEvCharger: Marker <doc:"充电桩">
